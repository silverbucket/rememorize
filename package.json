{
    "name": "rememorize",
    "version": "1.3.0",
    "private": true,
    "license": "GPL-3.0-or-later",
    "type": "module",
    "description": "Flashcards with FSRS spaced repetition, stored in your own remoteStorage",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "test:e2e": "playwright test",
        "screenshots": "vite build && node scripts/screenshots.mjs",
        "icons": "node scripts/icons.mjs",
        "armadietto:up": "docker compose up -d --build",
        "armadietto:down": "docker compose down"
    },
    "dependencies": {
        "@fontsource-variable/newsreader": "^5.3.0",
        "@fontsource-variable/schibsted-grotesk": "^5.3.0",
        "remotestorage-module-flashcards": "^2.2.0",
        "remotestoragejs": "2.0.0-beta.10",
        "svelte": "^5.58",
        "ts-fsrs": "^6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@playwright/test": "1.65.1",
        "@sveltejs/vite-plugin-svelte": "^7",
        "@types/node": "^26.6.6",
        "fake-indexeddb": "^6.2.8",
        "jsdom": "^31.0.1",
        "svelte-check": "^4",
        "typescript": "^6",
        "vite": "^8",
        "vite-plugin-pwa": "^2",
        "vitest": "^5",
        "workbox-window": "^7"
    }
}
